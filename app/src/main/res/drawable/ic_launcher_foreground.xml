<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Leaf -->
    <path android:pathData="M56,38 C59,28 67,22 78,23 C76,33 69,40 58,42 C57,41 56,40 56,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="58" android:startY="41"
                android:endX="76" android:endY="24"
                android:type="linear">
                <item android:offset="0" android:color="#006338" />
                <item android:offset="0.55" android:color="#168A3C" />
                <item android:offset="1" android:color="#78CC2D" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M58,40 C65,34 70,29 76,24"
        android:fillColor="#00000000"
        android:strokeColor="#5FBF31"
        android:strokeAlpha="0.78"
        android:strokeWidth="1.1"
        android:strokeLineCap="round" />

    <!-- Rear part of the orbit -->
    <path
        android:pathData="M69,45 C83,40 92,43 91,51 C90,56 86,61 81,65"
        android:fillColor="#00000000"
        android:strokeWidth="6.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="69" android:startY="45"
                android:endX="91" android:endY="60"
                android:type="linear">
                <item android:offset="0" android:color="#FF9B16" />
                <item android:offset="0.55" android:color="#FF6B25" />
                <item android:offset="1" android:color="#FF9724" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Fruit -->
    <path android:pathData="M53,35.2 a21.8,21.8 0,1 0,0 43.6 a21.8,21.8 0,1 0,0 -43.6">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="37" android:startY="39"
                android:endX="72" android:endY="76"
                android:type="linear">
                <item android:offset="0" android:color="#FFC52F" />
                <item android:offset="0.45" android:color="#FF941F" />
                <item android:offset="1" android:color="#FF5729" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft fruit highlight -->
    <path
        android:pathData="M39.5,49.5 C42.4,44.7 47.7,41.6 50.5,43.3 C53.1,45 50.5,50 46.6,53.1 C42.7,56.1 37.8,55.2 39.5,49.5 Z"
        android:fillColor="#FFE99A"
        android:fillAlpha="0.8" />

    <!-- Front orbit base -->
    <path
        android:pathData="M20,66 C34,79 62,80 84,61 C87,59 89,56 91,53"
        android:fillColor="#00000000"
        android:strokeWidth="8.1"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20" android:startY="70"
                android:endX="91" android:endY="48"
                android:type="linear">
                <item android:offset="0" android:color="#FF9B16" />
                <item android:offset="0.55" android:color="#FF6B25" />
                <item android:offset="1" android:color="#FF9724" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bright orbital cut -->
    <path
        android:pathData="M22,64 C37,75 63,75 83,58 C86,56 88,54 90,51"
        android:fillColor="#00000000"
        android:strokeColor="#FFFDF7"
        android:strokeWidth="4.6"
        android:strokeLineCap="round" />

    <!-- Secondary motion edge -->
    <path
        android:pathData="M22,72 C39,79 63,75 80,62"
        android:fillColor="#00000000"
        android:strokeColor="#FF7A20"
        android:strokeAlpha="0.9"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />
</vector>
